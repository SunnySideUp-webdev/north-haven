# Safe to expose in the browser. Use the publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Server-only. Do not prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Reserved for the read-only Google Calendar phase.
GOOGLE_CALENDAR_CLIENT_ID=replace-when-calendar-work-begins
GOOGLE_CALENDAR_CLIENT_SECRET=replace-when-calendar-work-begins
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-secret
