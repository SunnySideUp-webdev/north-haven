# Safe to expose in the browser. Use the publishable key, never a service-role key.
# Local: http://127.0.0.1:3000
# Vercel production: the exact https://<project>.vercel.app origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Server-only. Do not prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Read-only Google Calendar OAuth. Use an exact callback URI formed from
# NEXT_PUBLIC_APP_URL plus /api/google-calendar/callback. Generate the key with:
# openssl rand -base64 32
GOOGLE_CALENDAR_CLIENT_ID=replace-when-calendar-work-begins
GOOGLE_CALENDAR_CLIENT_SECRET=replace-when-calendar-work-begins
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-secret
